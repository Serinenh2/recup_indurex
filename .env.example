# ═══════════════════════════════════════════════
# 🔐 Django Core Security
# ═══════════════════════════════════════════════
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_LOG_LEVEL=WARNING

# ═══════════════════════════════════════════════
# 🗄️  Database (PostgreSQL recommended for production)
# ═══════════════════════════════════════════════
DB_ENGINE=django.db.backends.postgresql
DB_NAME=recup_indurex
DB_USER=recup_user
DB_PASSWORD=your-db-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
# DB_SSL_CA=/path/to/ca-certificate.crt  # Uncomment for SSL

# ═══════════════════════════════════════════════
# 🌐 CORS
# ═══════════════════════════════════════════════
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ═══════════════════════════════════════════════
# 🔒 HTTPS / SSL (when behind reverse proxy)
# ═══════════════════════════════════════════════
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_NUM_PROXIES=1

# ═══════════════════════════════════════════════
# 🐳 Docker / Deployment
# ═══════════════════════════════════════════════
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=your-admin-password
